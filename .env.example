# Copy to .env — loaded automatically by npm scripts (node --env-file-if-exists=.env)
NODE_ENV=development
PORT=8888
DATABASE_URL=mysql://webscan:webscan@localhost:3306/webscan
# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-change-me-change-me-change-me

# Used only by `npm test` (migration tests run down-migrations here)
TEST_DATABASE_URL=mysql://webscan:webscan@localhost:3306/webscan_test
